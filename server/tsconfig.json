{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src",
    "../src/lib"
  ],
  "exclude": [
    "../src/lib/push.ts"
  ]
}
